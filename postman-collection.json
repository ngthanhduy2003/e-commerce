    {
      "name": "6. Order Tracking",
      "description": "Public order tracking (no authentication required)",
      "item": [
        {
          "name": "Track Order by Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracking/{{trackingToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracking", "{{trackingToken}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Admin Panel",
      "description": "Admin-only operations (requires ADMIN role)",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders"],
              "query": [
                {"key": "page", "value": "0"},
                {"key": "size", "value": "20"},
                {"key": "status", "value": "PENDING", "disabled": true}
              ]
            }
          },
          "response": []
