    },
    {
      "name": "4. Track Multiple Orders (Runner)",
      "description": "Run with Collection Runner to test multiple orders at once",
      "item": [
        {
          "name": "4.1 Track Order - Parameterized",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Array of tracking tokens to test",
                  "const trackingTokens = [",
                  "    'track-abc123def456',      // Order 1 - PENDING",
                  "    'track-xyz789abc012',      // Order 2 - CONFIRMED",
                  "    'track-ship456def789',     // Order 3 - SHIPPED",
                  "    'track-delivered123',      // Order 4 - DELIVERED",
                  "    'track-jane123abc456'      // Order 5 - CONFIRMED",
                  "];",
                  "",
                  "// Get current iteration",
                  "const iteration = pm.info.iteration;",
                  "",
                  "// Set tracking token for this iteration",
                  "if (iteration < trackingTokens.length) {",
                  "    pm.collectionVariables.set('currentTrackingToken', trackingTokens[iteration]);",
                  "    console.log(`🔍 Testing order ${iteration + 1}: ${trackingTokens[iteration]}`);",
                  "} else {",
                  "    pm.collectionVariables.set('currentTrackingToken', 'invalid-token');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Tracking works', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Order data present', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.trackingToken).to.exist;",
                  "});",
                  "",
                  "// Log results",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('✅ SUCCESS:', jsonData.data.orderCode, '- Status:', jsonData.data.status);",
                  "} else {",
                  "    console.log('❌ FAILED: Order not found');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracking/{{currentTrackingToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracking", "{{currentTrackingToken}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Security Tests",
      "description": "Verify tracking is public but other endpoints are protected",
      "item": [
        {
          "name": "5.1 Tracking - Public Access (Should Work)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Public access works', function () {",
                  "    pm.response.to.have.status(200);",
                  "    console.log('✅ Public tracking confirmed - No auth needed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracking/track-abc123def456",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracking", "track-abc123def456"]
            }
          }
        },
        {
          "name": "5.2 Orders API - Protected (Should Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Orders endpoint is protected', function () {",
                  "    pm.response.to.have.status(401);",
                  "    console.log('✅ Orders endpoint properly protected - Requires auth');",
                  "});"
                ]
              }
